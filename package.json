{
  "name": "js-sha256",
  "version": "0.9.0",
  "description": "A simple SHA-256 / SHA-224 hash function for JavaScript supports UTF-8 encoding.",
  "main": "src/sha256.js",
  "module": "src/sha256.mjs",
  "exports": {
    ".": {
      "import": "./src/sha256.mjs",
      "require": "./src/sha256.js"
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.0.0",
    "@vitest/ui": "^2.0.0",
    "terser": "^5.31.3",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/emn178/js-sha256.git"
  },
  "keywords": [
    "sha",
    "sha2",
    "sha224",
    "sha256",
    "hash",
    "encryption",
    "cryptography",
    "HMAC"
  ],
  "license": "MIT",
  "author": "Chen, Yi-Cyuan <emn178@gmail.com>",
  "homepage": "https://github.com/emn178/js-sha256",
  "bugs": {
    "url": "https://github.com/emn178/js-sha256/issues"
  },
  "nyc": {
    "exclude": [
      "tests"
    ]
  }
}
